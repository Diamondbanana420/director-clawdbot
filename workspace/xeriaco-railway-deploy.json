{
  "name": "xeriaco-store",
  "description": "XeriaCO Public E-commerce Store",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  },
  "environments": {
    "production": {
      "PORT": "3000",
      "NODE_ENV": "production"
    }
  }
}