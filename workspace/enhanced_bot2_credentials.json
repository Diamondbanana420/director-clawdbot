{
  "botName": "XeriacoBot2",
  "deployment": "Enhanced Clawdbot + Discord Bot",
  "version": "2.0",
  
  "access": {
    "clawdbot": {
      "port": 8081,
      "setupUrl": "http://your-server.com:8081/setup",
      "controlUrl": "http://your-server.com:8081/clawdbot",
      "setupPassword": "xeriaco_bot2_2026_secure",
      "gatewayToken": "clawdbot_auto_f8e4a9b2c3d1e7f6a5b8c9d0e1f2a3b4"
    },
    "discord": {
      "botTokenRequired": "Set DISCORD_BOT_TOKEN environment variable",
      "setupUrl": "https://discord.com/developers/applications",
      "applicationName": "XeriacoBot2",
      "requiredIntents": ["MESSAGE_CONTENT_INTENT"],
      "requiredPermissions": ["Send Messages", "Use Slash Commands", "Embed Links", "Read Message History", "Add Reactions"]
    }
  },

  "discordCommands": {
    "storeManagement": {
      "/store-status": "Complete XeriaCO store dashboard with products, orders, profits",
      "/new-products": "Latest products ready for marketing promotion",  
      "/sales-report": "Daily sales metrics and profit analytics"
    },
    "marketingAutomation": {
      "/promote-product": "Generate marketing content for any product (Instagram, Twitter, Discord)",
      "/social-campaign": "Create platform-specific campaigns (Instagram/TikTok/Twitter)",
      "/flash-sale": "Announce limited time offers with countdown timers"
    },
    "customerService": {
      "/customer-help": "Automated customer support responses",
      "/track-order": "Help customers track order status"
    },
    "analytics": {
      "/marketing-analytics": "Campaign performance and engagement metrics",
      "/competitor-watch": "Monitor competitor activity and pricing"
    }
  },

  "integration": {
    "xericacoStoreAPI": "https://xeriaco.up.railway.app",
    "monitoringEndpoints": {
      "products": "/api/products",
      "orders": "/api/orders", 
      "health": "/api/health"
    },
    "automatedAlerts": [
      "New products added to store",
      "New orders received", 
      "System health issues",
      "Profit milestone achievements"
    ]
  },

  "deployment": {
    "directory": "/opt/xeriacobot2-discord",
    "container": "xeriacobot2-discord",
    "dockerImage": "Custom build with Clawdbot + Discord.js",
    "volumes": ["bot2_data:/data"],
    "networks": ["clawdbot-network"],
    "healthCheck": "Clawdbot + Discord bot status"
  },

  "serviceManagement": {
    "systemdService": "xeriacobot2-discord.service",
    "commands": {
      "start": "sudo systemctl start xeriacobot2-discord",
      "stop": "sudo systemctl stop xeriacobot2-discord", 
      "status": "sudo systemctl status xeriacobot2-discord",
      "logs": "sudo docker-compose logs -f",
      "restart": "sudo systemctl restart xeriacobot2-discord",
      "setDiscordToken": "export DISCORD_BOT_TOKEN=your_token && sudo docker-compose restart"
    }
  },

  "businessApplications": {
    "primaryUse": "XeriaCO marketing automation and customer service",
    "keyFeatures": [
      "Real-time store monitoring",
      "Automated marketing content generation",
      "Social media campaign creation", 
      "Flash sale announcements",
      "Customer service automation",
      "Analytics and performance tracking"
    ],
    "expectedResults": [
      "Increased Discord server engagement",
      "More effective product promotions", 
      "Automated customer support",
      "Higher conversion rates",
      "Reduced manual marketing effort"
    ]
  },

  "setupChecklist": [
    "✅ Run enhanced_autonomous_deploy.sh script",
    "⏳ Create Discord application at https://discord.com/developers/applications", 
    "⏳ Get Discord bot token and enable MESSAGE_CONTENT_INTENT",
    "⏳ Set DISCORD_BOT_TOKEN environment variable",
    "⏳ Invite bot to Discord server with proper permissions",
    "⏳ Complete Clawdbot setup wizard at :8081/setup",
    "⏳ Add OpenAI/Anthropic API key",
    "⏳ Test Discord commands (/store-status, /new-products)",
    "⏳ Verify XeriaCO store integration",
    "✅ Start marketing automation!"
  ],

  "troubleshooting": {
    "discordBotOffline": "Check DISCORD_BOT_TOKEN and restart container",
    "commandsNotWorking": "Verify MESSAGE_CONTENT_INTENT is enabled",
    "storeIntegrationFailed": "Check XeriaCO API accessibility",
    "clawdbotNotAccessible": "Verify port 8081 is open and service is running",
    "setupWizardFailed": "Check setup password and gateway token"
  }
}