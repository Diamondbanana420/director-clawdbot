{
    "models": {
          "mode": "merge",
          "providers": {
                  "deepseek": {
                            "baseUrl": "https://api.deepseek.com/v1",
                            "apiKey": "__DEEPSEEK_API_KEY__",
                            "api": "openai-completions",
                            "models": [
                                        {
                                                      "id": "deepseek-chat",
                                                      "name": "DeepSeek Chat (V3)",
                                                      "input": [ "text" ],
                                                      "contextWindow": 64000,
                                                      "maxTokens": 8192
                                        }
                            ]
                  }
          }
    },
    "agents": {
          "defaults": {
                  "model": {
                            "primary": "deepseek/deepseek-chat"
                  },
                  "workspace": "/root/clawd",
                  "maxConcurrent": 3,
                  "subagents": {
                            "maxConcurrent": 2
                  }
          }
    },
    "commands": {
          "native": "auto",
          "nativeSkills": "auto"
    },
    "channels": {
          "discord": {
                  "token": "__DISCORD_BOT_TOKEN__",
                  "groupPolicy": "open",
                  "mediaMaxMb": 25,
                  "actions": {
                            "reactions": true,
                            "messages": true,
                            "threads": true,
                            "pins": true,
                            "search": true,
                            "memberInfo": true,
                            "roleInfo": true,
                            "channelInfo": true,
                            "emojiUploads": true,
                            "stickerUploads": true
                  }
          }
    },
    "gateway": {
          "mode": "local",
          "port": 18789,
          "auth": {
                  "mode": "token",
                  "token": "bf4765e62a04f87f5d339499fc25aa01"
          },
          "controlUi": {
                  "enabled": true,
                  "allowInsecureAuth": true
          }
    },
    "messages": {
          "ackReactionScope": "all"
    },
    "plugins": {
          "entries": {
                  "discord": {
                            "enabled": true
                  }
          }
    }
}
